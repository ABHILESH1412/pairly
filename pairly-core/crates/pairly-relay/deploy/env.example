# Copy to .env and fill in.
# A long random secret; generate one with:  openssl rand -hex 16
PAIRLY_RELAY_TOKENS=
# Your server's public IP or DNS name (only used to print the address for you).
PAIRLY_RELAY_PUBLIC_HOST=
# Optional bandwidth cap per device pair and direction, in Mbit/s (0 = none).
PAIRLY_RELAY_RATE_LIMIT_MBPS=0
