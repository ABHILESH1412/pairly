# systemd unit for running pairly-relay without Docker.
#   sudo install -m755 pairly-relay /usr/local/bin/
#   sudo install -m644 pairly-relay.service /etc/systemd/system/
#   sudo install -m600 /dev/null /etc/pairly-relay.env   # then put PAIRLY_RELAY_TOKENS=... in it
#   sudo systemctl enable --now pairly-relay
[Unit]
Description=Pairly blind relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/pairly-relay
EnvironmentFile=/etc/pairly-relay.env
Environment=PAIRLY_RELAY_DATA=/var/lib/pairly-relay
DynamicUser=yes
StateDirectory=pairly-relay
Restart=on-failure
RestartSec=2
# Hardening: the relay only needs UDP and its state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
