{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pairly",
  "version": "0.1.4",
  "identifier": "io.github.abhilesh1412.pairly",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pairly",
        "width": 1100,
        "height": 720,
        "minWidth": 380,
        "minHeight": 520,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Abhilesh Singh",
    "copyright": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Your phone and your PC, working as one",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgOTgzMkU4M0U3NUQ2MUJFMgpSV1RpRzlaMVB1Z3ltRnBGSDVON1BUVGFOdXo2M3FETGRqWXhFNzBVSit1NUUxaUZPSjA2eGVLeQo=",
      "endpoints": [
        "https://github.com/ABHILESH1412/pairly/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
